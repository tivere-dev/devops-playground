// Grafana Alloy: collects the logs of every Docker container and sends them to Loki.
// (Alloy replaces Promtail, the older log collector you may read about.)

// 1. Find all running containers through the Docker socket
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

// 2. Turn the container name into a label called "container" (e.g. container="app-blue")
discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

// 3. Read the logs of those containers
loki.source.docker "default" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.write.local.receiver]
}

// 4. Send them to Loki
loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
